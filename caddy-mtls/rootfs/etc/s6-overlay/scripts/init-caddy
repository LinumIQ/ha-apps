#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Caddy mTLS Proxy
# Init oneshot: validate config, ensure the CA, refresh /data/state.json
# metadata, issue certificates for new names in `client_names` (every start),
# re-encrypt .p12 bundles after a client_cert_password change, check whether
# the upstream accepts forwarded requests (forwarded_headers), render the
# Caddyfile, generate the CRL, populate the active-cert allowlist.
# ==============================================================================
set -e

# shellcheck source=rootfs/etc/s6-overlay/scripts/lib/cert-helpers.sh
source /etc/s6-overlay/scripts/lib/cert-helpers.sh
# shellcheck source=rootfs/etc/s6-overlay/scripts/lib/state.sh
source /etc/s6-overlay/scripts/lib/state.sh
# shellcheck source=rootfs/etc/s6-overlay/scripts/lib/dns-provider.sh
source /etc/s6-overlay/scripts/lib/dns-provider.sh

###############################################################################
# Paths (also referenced by the Caddyfile)
###############################################################################
readonly CERT_DIR="/data/certs"
readonly CADDY_DATA="/data/caddy"
readonly CADDYFILE="/etc/caddy/Caddyfile"
# Caddy's certificate events (JSON), read by the panel and the expiry monitor
# (public_cert.py). Caddy runs as root; the file is 0600.
readonly ACME_LOG="${CADDY_DATA}/log/acme.log"
# Facts of this start for the panel and the monitor (host ports, domain,
# upstream, start time); /run is empty at every start.
readonly RUNTIME_DIR="/run/caddy-mtls"
readonly RUNTIME_FILE="${RUNTIME_DIR}/runtime.json"
# The header lines of the reverse_proxy blocks (forwarded_headers): written
# by upstream.py at every start and rewritten at run time when the mode
# changes (then Caddy is reloaded).
readonly FORWARD_SNIPPET="/etc/caddy/forwarded-headers.caddy"
readonly UPSTREAM_PY="/usr/lib/cert-mgr/upstream.py"
readonly LAN_PY="/usr/lib/cert-mgr/lan.py"
readonly PANEL_PYTHON="/usr/lib/cert-mgr/.venv/bin/python3"
STARTED_AT="$(date +%s)"

mkdir -p "${CERT_DIR}" "${CADDY_DATA}" "${CADDY_DATA}/log" "${RUNTIME_DIR}"
chmod 700 "${CERT_DIR}" "${CADDY_DATA}/log"
chmod 755 "${RUNTIME_DIR}"

###############################################################################
# Read configuration
###############################################################################
bashio::log.info "Reading configuration..."

DOMAIN="$(bashio::config 'domain')"
EMAIL="$(bashio::config 'email')"
UPSTREAM_HOST="$(bashio::config 'upstream_host')"
# Optional since 2.0.0 (resolved below); bashio prints "null" when unset.
UPSTREAM_PORT="$(bashio::config 'upstream_port')"
[[ "${UPSTREAM_PORT}" == "null" ]] && UPSTREAM_PORT=""
MTLS_ENABLED="$(bashio::config 'mtls_enabled')"
# Since 2.2.0; options saved before have no key (bashio's default applies).
FORWARDED_HEADERS="$(bashio::config 'forwarded_headers' 'auto')"

CA_COUNTRY="$(bashio::config 'ca_country')"
CA_STATE="$(bashio::config 'ca_state')"
CA_LOCALITY="$(bashio::config 'ca_locality')"
CA_ORGANIZATION="$(bashio::config 'ca_organization')"
CA_COMMON_NAME="$(bashio::config 'ca_common_name')"

CLIENT_CERT_PASSWORD="$(bashio::config 'client_cert_password')"

ACME_DNS_PROVIDER="$(bashio::config 'acme_dns_provider')"
DNS_API_TOKEN="$(bashio::config 'dns_api_token')"
# Optional (password?): bashio prints "null" when the key is missing.
[[ "${DNS_API_TOKEN}" == "null" ]] && DNS_API_TOKEN=""
LOG_LEVEL="$(bashio::config 'log_level' 'info')"
ACCESS_LOG="$(bashio::config 'access_log' 'false')"

# Required by the helper functions and the cert-mgr / cert-monitor services.
export CERT_DIR DOMAIN \
       CA_COUNTRY CA_STATE CA_LOCALITY CA_ORGANIZATION CA_COMMON_NAME \
       CLIENT_CERT_PASSWORD

###############################################################################
# Validation
###############################################################################
if bashio::var.is_empty "${DOMAIN}"; then
    bashio::exit.nok "Option 'domain' is required (e.g. home.example.com)."
fi

# A bare host name only: a port (e.g. home.example.com:8443) would make Caddy
# listen on an unpublished container port and clash with the plain-HTTP CRL
# site. The public ports stay 80/443 - the router forwards them to the host
# ports in the add-on's Network settings.
if [[ "${DOMAIN}" == *[:/]* ]]; then
    bashio::exit.nok "Option 'domain' must be a host name without scheme, port or path (e.g. home.example.com); the router forwards the public ports 80/443 to the add-on's host ports."
fi
DOMAIN_RE='^[A-Za-z0-9*]([A-Za-z0-9.*_-]*[A-Za-z0-9])?$'
if [[ ! "${DOMAIN}" =~ ${DOMAIN_RE} ]]; then
    bashio::exit.nok "Option 'domain' is not a valid host name: '${DOMAIN}'."
fi

if bashio::var.is_empty "${EMAIL}"; then
    bashio::exit.nok "Option 'email' is required for Let's Encrypt registration."
fi

case "${ACME_DNS_PROVIDER}" in
    none|cloudflare|route53|hetzner) ;;
    *) bashio::exit.nok "Unknown acme_dns_provider '${ACME_DNS_PROVIDER}'." ;;
esac

case "${FORWARDED_HEADERS}" in
    auto|always|never) ;;
    *) bashio::exit.nok "Unknown forwarded_headers '${FORWARDED_HEADERS}' (auto, always or never)." ;;
esac

# forwarded_headers: never needs mTLS (for every upstream). Without client
# certificates the visitors are anyone on the internet; hiding their
# addresses would make each of them look like a local device to the
# upstream (Home Assistant: "local network only" users, local-only webhooks,
# trusted networks).
if [[ "${FORWARDED_HEADERS}" == "never" ]] && ! bashio::var.true "${MTLS_ENABLED}"; then
    bashio::exit.nok "forwarded_headers: never needs mtls_enabled: true. Without client certificates the add-on never hides visitor addresses from the upstream: every visitor from the internet would look like a device in your local network to it. Turn mTLS on (mtls_enabled: true), or set forwarded_headers to auto and let Home Assistant trust this add-on as a reverse proxy (Settings > System > Network > HTTP server > Reverse proxy; see the documentation)."
fi

if [[ "${ACME_DNS_PROVIDER}" != "none" ]] && bashio::var.is_empty "${DNS_API_TOKEN}"; then
    bashio::exit.nok "DNS API token is required when acme_dns_provider is '${ACME_DNS_PROVIDER}'."
fi

# Upstream port. Unset (the default since 2.0.0) with the default upstream
# `homeassistant`: Home Assistant Core's own port from the Supervisor API -
# new Home Assistant OS installations (2026.8+) serve Core on port 80, older
# ones on 8123. Without the API (outside Supervisor) 8123 is assumed.
UPSTREAM_PORT_SOURCE="option upstream_port"
if bashio::var.is_empty "${UPSTREAM_PORT}"; then
    if [[ "${UPSTREAM_HOST}" != "homeassistant" ]]; then
        bashio::exit.nok "Option 'upstream_port' is required when upstream_host is not 'homeassistant'."
    fi
    UPSTREAM_PORT=""
    if [[ -n "${SUPERVISOR_TOKEN:-}" ]] || bashio::cache.exists 'core.info'; then
        UPSTREAM_PORT="$(bashio::core.port)" || UPSTREAM_PORT=""
    fi
    if [[ "${UPSTREAM_PORT}" =~ ^[0-9]+$ ]] && (( UPSTREAM_PORT >= 1 && UPSTREAM_PORT <= 65535 )); then
        UPSTREAM_PORT_SOURCE="Home Assistant Core's port from the Supervisor API"
    else
        UPSTREAM_PORT=8123
        UPSTREAM_PORT_SOURCE="Core's port unknown (no Supervisor API) - default 8123"
        bashio::log.warning "Could not read Home Assistant Core's port from the Supervisor API; proxying to homeassistant:8123. Set 'upstream_port' if Core uses another port."
    fi
fi

# Exported for `caddy validate` below; the caddy service exports the same
# variables itself (see lib/dns-provider.sh).
if ! dns_provider_export "${ACME_DNS_PROVIDER}" "${DNS_API_TOKEN}"; then
    if [[ "${ACME_DNS_PROVIDER}" == "route53" ]]; then
        bashio::exit.nok "For route53, dns_api_token must be ACCESS_KEY_ID:SECRET_ACCESS_KEY."
    fi
    bashio::exit.nok "Invalid dns_api_token for acme_dns_provider '${ACME_DNS_PROVIDER}'."
fi

# Test-only override (Supervisor offers no way to set an add-on's environment,
# so it is never set there): ACME_CA_URL replaces the ACME directories of
# Let's Encrypt / ZeroSSL, e.g. with a local test CA or an unreachable
# sinkhole (tests/smoke.sh). It is set as the global `acme_ca` and, with a
# DNS provider, also as the site's `ca` (see below).
ACME_CA_URL="${ACME_CA_URL:-}"
ACME_CA_URL_RE='^https?://[A-Za-z0-9._~:/?=&%-]+$'
if [[ -n "${ACME_CA_URL}" ]]; then
    if [[ ! "${ACME_CA_URL}" =~ ${ACME_CA_URL_RE} ]]; then
        bashio::exit.nok "ACME_CA_URL is not a plain http(s) URL."
    fi
    bashio::log.warning "ACME_CA_URL is set: certificates are requested from ${ACME_CA_URL} only (test override)."
fi

if bashio::var.true "${MTLS_ENABLED}" && bashio::var.is_empty "${CLIENT_CERT_PASSWORD}"; then
    bashio::exit.nok "client_cert_password must be set when mTLS is enabled."
fi

###############################################################################
# Initialise state file (atomic, idempotent)
###############################################################################
state_init

###############################################################################
# client_names: a listed name that state.json does not know gets a client
# certificate - on every start, not only the first one. Nothing is ever
# revoked here (removing a name from the option keeps the client; the panel
# revokes), and a name whose client was revoked is skipped: a revoked name is
# never issued again. Invalid names are skipped with a warning instead of
# stopping the start (Supervisor validates the option with the same rule).
# Arguments:
#   $1 - client name from the option
###############################################################################
ensure_option_client() {
    local name="$1" status
    [[ -z "${name}" ]] && return 0
    if ! client_name_valid "${name}"; then
        bashio::log.warning "client_names: skipping $(jq -rn --arg n "${name}" '$n | @json'): a client name has 1-64 characters (letters, digits, '.', '_', '-') and does not start with a dot."
        return 0
    fi
    status="$(state_client_status "${name}")"
    case "${status}" in
        active)
            return 0
            ;;
        revoked)
            bashio::log.warning "client_names: skipping '${name}': this client was revoked, and a revoked name is never issued again. Remove it from client_names (use a new name for a new certificate)."
            return 0
            ;;
        "")
            ;;
        *)
            bashio::log.warning "client_names: skipping '${name}': unexpected status '${status}' in state.json."
            return 0
            ;;
    esac
    if client_cert_reusable "${name}"; then
        bashio::log.info "client_names: tracking the existing certificate of '${name}'."
    else
        bashio::log.info "client_names: issuing a client certificate for '${name}'."
        generate_client_cert "${name}"
    fi
    state_refresh_client "${name}"
}

###############################################################################
# Generate certificates if mTLS is enabled
###############################################################################
if bashio::var.true "${MTLS_ENABLED}"; then
    bashio::log.info "mTLS is enabled, ensuring certificates are present..."

    if [[ ! -f "${CERT_DIR}/mTLS-CA.crt" ]]; then
        bashio::log.info "Generating CA certificate..."
        generate_ca
    else
        bashio::log.info "Reusing existing CA certificate."
        init_ca_db
    fi

    state_refresh_ca

    # (Arrays, not `while read` loops: openssl must not read the loop's
    # input. jq --raw-output0: one array element per option entry, whatever
    # characters it contains.)
    bashio::log.info "Refreshing metadata for tracked clients..."
    mapfile -t TRACKED_CLIENTS < <(state_all_clients)
    for client_name in "${TRACKED_CLIENTS[@]}"; do
        [[ -z "${client_name}" ]] && continue
        state_refresh_client "${client_name}"
    done

    bashio::log.info "Checking 'client_names' for new clients..."
    mapfile -d '' -t OPTION_CLIENTS < <(jq --raw-output0 '.client_names[]? | tostring' /data/options.json)
    for client_name in "${OPTION_CLIENTS[@]}"; do
        ensure_option_client "${client_name}"
    done

    # Every active client's .p12 bundle must open with the current
    # client_cert_password; otherwise (the password was changed - bundles
    # issued with the old one, e.g. the public default, kept it) it is
    # re-exported from the client's key and certificate. The /config mirror
    # below copies the new bundles.
    mapfile -t ACTIVE_CLIENTS < <(state_active_clients)
    for client_name in "${ACTIVE_CLIENTS[@]}"; do
        [[ -z "${client_name}" ]] && continue
        client_p12_opens "${client_name}" && continue
        if reencrypt_client_p12 "${client_name}"; then
            bashio::log.info "Re-encrypted the .p12 bundle of client '${client_name}' with the current client_cert_password."
        else
            bashio::log.warning "The .p12 bundle of client '${client_name}' does not open with the current client_cert_password and could not be re-exported (key or certificate missing)."
        fi
    done
fi

###############################################################################
# Populate active client cert directory + (re)generate CRL
###############################################################################
if bashio::var.true "${MTLS_ENABLED}"; then
    bashio::log.info "Populating active client cert allowlist..."
    state_sync_active_dir

    bashio::log.info "Generating CRL..."
    generate_crl
    state_refresh_crl
fi

###############################################################################
# Published host ports, read before rendering: the local-network site exists
# only while container port 4443/tcp has a host port (since 2.2.0). Caddy
# listens on 80/443/4443 inside the container; the host ports are set in the
# add-on's Network settings (defaults 8080/8443 since 2.0.0: new Home
# Assistant OS installations (2026.8+) serve Home Assistant itself on 80/443;
# 4443/tcp unpublished). Outside Supervisor (no API token and no cached add-on
# info) they are unknown - and the local-network site stays off.
###############################################################################
HOST_PORTS_KNOWN=false
HTTP_HOST_PORT=""
HTTPS_HOST_PORT=""
LAN_HOST_PORT=""
# on | off (no host port) | unknown (could not be read: off as well)
LAN_STATE=unknown
read_host_ports() {
    local http_port https_port lan_port
    if [[ -z "${SUPERVISOR_TOKEN:-}" ]] && ! bashio::cache.exists 'addons.self.info'; then
        return 0
    fi
    http_port="$(bashio::app.port 80/tcp)" || return 0
    https_port="$(bashio::app.port 443/tcp)" || return 0
    [[ "${http_port}" =~ ^[0-9]+$ ]] || http_port=""
    [[ "${https_port}" =~ ^[0-9]+$ ]] || https_port=""
    HOST_PORTS_KNOWN=true
    HTTP_HOST_PORT="${http_port}"
    HTTPS_HOST_PORT="${https_port}"
    lan_port="$(bashio::app.port 4443/tcp)" || return 0
    if [[ "${lan_port}" =~ ^[0-9]+$ ]] && (( lan_port >= 1 && lan_port <= 65535 )); then
        LAN_HOST_PORT="${lan_port}"
        LAN_STATE=on
    else
        LAN_STATE=off
    fi
}
read_host_ports || true

# The add-on's own folder in Home Assistant's app configuration folders (on
# the host app_configs/<slug>/, called addon_configs before Supervisor
# 2026.7; /config in here): the slug ends in _caddy_mtls and starts with the
# repository's hash (local_ for a local copy). The panel shows the real
# folder; unknown outside Supervisor.
CONFIG_SLUG=""
read_config_slug() {
    local slug
    if [[ -z "${SUPERVISOR_TOKEN:-}" ]] && ! bashio::cache.exists 'addons.self.info'; then
        return 0
    fi
    slug="$(bashio::app.slug)" || return 0
    if [[ "${slug}" != null && "${slug}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$ ]]; then
        CONFIG_SLUG="${slug}"
    fi
}
read_config_slug || true

# The local-network site answers private source addresses only (lan.py) and
# refuses the container's default gateways although they are private:
# Docker's userland proxy forwards IPv6 connections to a container without
# IPv6 (and connections from the host itself) from that address, which hides
# the real source - possibly a public IPv6 client.
LAN_PRIVATE_RANGES=""
LAN_REFUSED=()
if [[ "${LAN_STATE}" == on ]]; then
    LAN_GATEWAYS=""
    if ! LAN_PRIVATE_RANGES="$("${PANEL_PYTHON}" "${LAN_PY}" ranges)" \
        || ! LAN_GATEWAYS="$("${PANEL_PYTHON}" "${LAN_PY}" gateways)" \
        || [[ ! "${LAN_PRIVATE_RANGES}" =~ ^[0-9a-fA-F.:/\ ]+$ ]]; then
        bashio::log.warning "Could not read the container's network (lan.py): the local-network port stays off."
        LAN_STATE=unknown
        LAN_HOST_PORT=""
    else
        while IFS= read -r gateway; do
            [[ "${gateway}" =~ ^[0-9a-fA-F.:]+$ ]] && LAN_REFUSED+=("${gateway}")
        done <<<"${LAN_GATEWAYS}"
    fi
fi

###############################################################################
# Forwarding headers (option forwarded_headers, since 2.2.0). Home Assistant
# answers a request with X-Forwarded-For "400: Bad Request" unless it trusts
# this add-on as a reverse proxy. upstream.py asks the upstream (at most
# about 5 s: at host boot the add-on starts before Home Assistant), decides
# whether visitor addresses are passed on (mode pass) or the forwarding
# headers are removed (mode strip) and writes ${FORWARD_SNIPPET}, which the
# reverse_proxy block imports. The monitor watches the upstream afterwards
# and switches the mode at run time (rewrite + caddy reload).
###############################################################################
bashio::log.info "Checking the upstream ${UPSTREAM_HOST}:${UPSTREAM_PORT} (forwarded_headers: ${FORWARDED_HEADERS})..."
MTLS_BOOL=false
bashio::var.true "${MTLS_ENABLED}" && MTLS_BOOL=true
UPSTREAM_JSON=""
if ! UPSTREAM_JSON="$(timeout 15 "${PANEL_PYTHON}" "${UPSTREAM_PY}" start \
        --domain "${DOMAIN}" --host "${UPSTREAM_HOST}" --port "${UPSTREAM_PORT}" \
        --mtls "${MTLS_BOOL}" --option "${FORWARDED_HEADERS}")" \
        || ! jq -e '.card' >/dev/null 2>&1 <<<"${UPSTREAM_JSON}"; then
    bashio::log.warning "Could not check the upstream; the monitor tries again in a few seconds."
    UPSTREAM_JSON=""
fi
# upstream() <key>: a fact of the check ("" if unknown; never fails).
upstream() { [[ -z "${UPSTREAM_JSON}" ]] || jq -r --arg k "$1" '.[$k] // "" | tostring' <<<"${UPSTREAM_JSON}"; }
if [[ ! -s "${FORWARD_SNIPPET}" ]]; then
    # Only when upstream.py could not run: the headers passed on (as up to
    # 2.1.x) - removed with forwarded_headers: never; the monitor rewrites
    # the file with its decision.
    if [[ "${FORWARDED_HEADERS}" == "never" ]]; then
        printf '%s\n' '# Forwarding headers, mode strip (fallback of init-caddy).' \
            'header_up -X-Forwarded-For' 'header_up -X-Forwarded-Proto' 'header_up -X-Forwarded-Host' \
            'header_up -X-Real-IP' 'header_up -Forwarded' >"${FORWARD_SNIPPET}"
    else
        printf '%s\n' '# Forwarding headers, mode pass (fallback of init-caddy).' \
            'header_up X-Real-IP {remote_host}' 'header_up -Forwarded' >"${FORWARD_SNIPPET}"
    fi
    chmod 644 "${FORWARD_SNIPPET}"
fi

###############################################################################
# Render Caddyfile
###############################################################################
bashio::log.info "Rendering Caddyfile..."

# Map bashio log levels onto Caddy log levels.
case "${LOG_LEVEL}" in
    trace|debug)            CADDY_LOG_LEVEL="DEBUG" ;;
    info|notice)            CADDY_LOG_LEVEL="INFO" ;;
    warning)                CADDY_LOG_LEVEL="WARN" ;;
    error|fatal)            CADDY_LOG_LEVEL="ERROR" ;;
    *)                      CADDY_LOG_LEVEL="INFO" ;;
esac

# Caddy's access log ("handled request", one line of ~1.5 KB per request):
# only with access_log: true, or with log_level debug / trace. Its entries
# have level INFO (ERROR for 5xx), so it logs at INFO even with a higher
# log_level.
SITE_LOG=""
if bashio::var.true "${ACCESS_LOG}" || [[ "${CADDY_LOG_LEVEL}" == "DEBUG" ]]; then
    ACCESS_LOG_LEVEL="INFO"
    [[ "${CADDY_LOG_LEVEL}" == "DEBUG" ]] && ACCESS_LOG_LEVEL="DEBUG"
    SITE_LOG="
    log {
        output stdout
        format console
        level ${ACCESS_LOG_LEVEL}
    }"
fi

# The loggers of certificate management: obtaining / renewing (the retry
# loop's "will retry" and "certificate obtained successfully" included), the
# ACME client (challenge results) and the ACME issuer.
readonly ACME_LOGGERS="tls.obtain tls.renew tls.issuance http.acme_client"

# The certificate automation (identical for every HTTPS site of the domain,
# so the public and the local-network site share one certificate and one
# automation policy) ...
TLS_ISSUER_DIRECTIVES=""
if [[ "${ACME_DNS_PROVIDER}" != "none" ]]; then
    # The secret is passed via environment variables referenced through
    # Caddy's {env.X} placeholders, so it never lands in the on-disk
    # Caddyfile and cannot break the Caddyfile syntax.
    TLS_ISSUER_DIRECTIVES="${TLS_ISSUER_DIRECTIVES}$(dns_provider_directive "${ACME_DNS_PROVIDER}" "        ")
"
    # A site-level ACME issuer (created by `dns`) keeps Caddy's default
    # ZeroSSL fallback unless the CA is set on the site itself.
    if [[ -n "${ACME_CA_URL}" ]]; then
        TLS_ISSUER_DIRECTIVES="${TLS_ISSUER_DIRECTIVES}        ca ${ACME_CA_URL}
"
    fi
fi

# ... and the client certificates (the public site only).
TLS_DIRECTIVES="${TLS_ISSUER_DIRECTIVES}"
if bashio::var.true "${MTLS_ENABLED}"; then
    TLS_DIRECTIVES="${TLS_DIRECTIVES}        client_auth {
            mode require_and_verify
            trust_pool file {
                pem_file ${CERT_DIR}/mTLS-CA.crt
            }
            verifier leaf {
                folder ${CERT_DIR}/active
            }
        }
"
fi

# Caddy rejects an empty 'tls { }' block. Only emit it when we have
# directives to put inside; otherwise omit it entirely so Caddy falls back
# to fully automatic HTTPS (HTTP-01 / TLS-ALPN challenges).
TLS_BLOCK=""
ACME_CA_OPTION=""
if [[ -n "${ACME_CA_URL}" ]]; then
    ACME_CA_OPTION=$'\n'"    acme_ca ${ACME_CA_URL}"
fi
if [[ -n "${TLS_DIRECTIVES}" ]]; then
    TLS_BLOCK="tls {
${TLS_DIRECTIVES}    }"
fi
LAN_TLS_BLOCK=""
if [[ -n "${TLS_ISSUER_DIRECTIVES}" ]]; then
    LAN_TLS_BLOCK="tls {
${TLS_ISSUER_DIRECTIVES}    }"
fi

# Plain-HTTP site (container port 80), rendered always since 2.2.0: the CRL
# (with mTLS) and a redirect of everything else to https://<domain>/ - port
# 443, the router's path. Caddy's automatic redirect is not relied on: with a
# second HTTPS site for the domain (the local-network port) it would have to
# pick one of the two ports. Caddy still serves the ACME HTTP-01 challenge on
# this listener automatically; user routes only run for non-challenge
# requests.
CRL_HANDLER=""
if bashio::var.true "${MTLS_ENABLED}"; then
    CRL_HANDLER="
    @crl path /mTLS-CA.crl
    handle @crl {
        root * ${CERT_DIR}
        file_server
    }"
fi
HTTP_SITE="
http://${DOMAIN} {${CRL_HANDLER}
    # Anything else is redirected to HTTPS (port 443).
    handle {
        redir https://{host}{uri} permanent
    }
${SITE_LOG}
}
"

# Local-network site (container port 4443, only with a host port): HTTPS
# without client certificates, for private source addresses only. Its host
# port must never be forwarded by the router; the private-address rule is a
# second line (a published port is reachable over IPv6 wherever the router's
# IPv6 firewall lets connections in).
LAN_SITE=""
if [[ "${LAN_STATE}" == on ]]; then
    LAN_GATEWAY_MATCHER=""
    LAN_GATEWAY_RULE=""
    if (( ${#LAN_REFUSED[@]} > 0 )); then
        LAN_GATEWAY_MATCHER="
    @docker_gateway remote_ip ${LAN_REFUSED[*]}"
        LAN_GATEWAY_RULE="
        respond @docker_gateway \"403 Forbidden: this connection came from {remote_host}, the address of Docker on the Home Assistant host, which hides where the connection really comes from (an IPv6 connection, or one from the host itself). Connect over IPv4 from a device in your local network: let ${DOMAIN} resolve to the IPv4 address of the Home Assistant host.\" 403"
    fi
    LAN_SITE="
# Local network (container port 4443): no client certificate, private
# source addresses only. Never forward its host port on the router.
https://${DOMAIN}:4443 {
    ${LAN_TLS_BLOCK}
${LAN_GATEWAY_MATCHER}
    @not_private not remote_ip ${LAN_PRIVATE_RANGES}

    route {${LAN_GATEWAY_RULE}
        respond @not_private \"403 Forbidden: this HTTPS port of the Caddy mTLS Proxy answers only devices in your local network (private addresses), and this connection came from {remote_host}. From the internet, use https://${DOMAIN}/ with a client certificate.\" 403
        reverse_proxy ${UPSTREAM_HOST}:${UPSTREAM_PORT} {
            # Forwarding headers (forwarded_headers; rewritten at run time)
            import ${FORWARD_SNIPPET}
        }
    }
${SITE_LOG}
}
"
fi

cat > "${CADDYFILE}" <<CADDYFILE
# Caddy mTLS Proxy - generated by init-caddy on every start. Do not edit.

{
    email ${EMAIL}${ACME_CA_OPTION}

    storage file_system {
        root ${CADDY_DATA}
    }

    # Loopback-only admin API so cert-mgr can reload Caddy in-place.
    admin localhost:2019

    # A stop or reload waits at most 10 s for open requests (default:
    # forever), so the add-on always stops within Supervisor's timeout.
    grace_period 10s

    # Everything goes to the add-on log - except the admin API's request
    # lines (one per health probe and per panel action).
    log default {
        output stdout
        format console
        level ${CADDY_LOG_LEVEL}
        exclude admin.api
    }

    # Certificate events also go to ${ACME_LOG} (JSON, 0600) for the
    # panel's "Public certificate" card and the expiry monitor.
    log acme_file {
        output file ${ACME_LOG} {
            mode 0600
            roll_size 1MiB
            roll_keep 2
        }
        format json
        level INFO
        include ${ACME_LOGGERS}
    }

    # A log with "include" takes its loggers out of the default log, so the
    # certificate events are written to the add-on log here.
    log acme_console {
        output stdout
        format console
        level ${CADDY_LOG_LEVEL}
        include ${ACME_LOGGERS}
    }
}

# Public mTLS-protected reverse proxy
${DOMAIN} {
    ${TLS_BLOCK}

    reverse_proxy ${UPSTREAM_HOST}:${UPSTREAM_PORT} {
        # Forwarding headers (forwarded_headers; rewritten at run time)
        import ${FORWARD_SNIPPET}
    }
${SITE_LOG}
}
${HTTP_SITE}${LAN_SITE}
CADDYFILE

# Caddy's own formatting (tabs), so that `caddy validate` / `caddy run` do
# not warn "Caddyfile input is not formatted" at every start.
if ! /usr/bin/caddy fmt --overwrite "${CADDYFILE}" >/dev/null 2>&1; then
    bashio::log.warning "caddy fmt could not format ${CADDYFILE}; validating it as it is."
fi

bashio::log.info "Validating generated Caddyfile..."
# The output is scrubbed of the DNS credentials: e.g. the Cloudflare module
# quotes a token it considers malformed in its error message.
VALIDATE_RC=0
/usr/bin/caddy validate --config "${CADDYFILE}" --adapter caddyfile 2>&1 \
    | dns_provider_redact "${DNS_API_TOKEN}" || VALIDATE_RC=$?
if (( VALIDATE_RC != 0 )); then
    bashio::exit.nok "Generated Caddyfile failed validation"
fi

###############################################################################
# Mirror certs to /config for user access via the Samba/SSH/file editor apps
# (on the host: app_configs/<slug>/certs/). Only here, at the start: a client
# added, revoked or regenerated in the web interface shows up in (or leaves)
# the copy at the next start.
###############################################################################
if bashio::var.true "${MTLS_ENABLED}" && [[ -d "/config" ]]; then
    bashio::log.info "Mirroring certificates to /config/certs..."
    mkdir -p /config/certs
    chmod 700 /config/certs

    if ! cp "${CERT_DIR}/mTLS-CA.crt" /config/certs/; then
        bashio::log.warning "Could not copy CA cert to /config/certs"
    else
        chmod 644 /config/certs/mTLS-CA.crt
    fi

    if [[ -f "${CERT_DIR}/mTLS-CA.crl" ]]; then
        cp "${CERT_DIR}/mTLS-CA.crl" /config/certs/ 2>/dev/null || true
        chmod 644 /config/certs/mTLS-CA.crl 2>/dev/null || true
    fi

    declare -A MIRRORED_CLIENTS=()
    while IFS= read -r client_name; do
        [[ -z "${client_name}" ]] && continue
        MIRRORED_CLIENTS["${client_name}"]=1
        src="${CERT_DIR}/mTLS-client-${client_name}.p12"
        dst="/config/certs/mTLS-client-${client_name}.p12"
        if [[ -f "${src}" ]] && cp "${src}" "${dst}"; then
            chmod 600 "${dst}"
        elif [[ -f "${src}" ]]; then
            bashio::log.warning "Could not copy '${src}' to /config/certs"
        fi
    done < <(state_active_clients)

    # The bundles of clients that are no longer active (revoked, or not
    # re-issued with a regenerated CA) leave the copy (since 2.3.0; before,
    # they stayed there for good). Only the add-on's own file names.
    for dst in /config/certs/mTLS-client-*.p12; do
        [[ -f "${dst}" && ! -L "${dst}" ]] || continue
        client_name="${dst#/config/certs/mTLS-client-}"
        client_name="${client_name%.p12}"
        [[ -n "${MIRRORED_CLIENTS["${client_name}"]:-}" ]] && continue
        if rm -f -- "${dst}"; then
            bashio::log.info "Removed the copy of '${client_name}' from /config/certs (the client is not active)."
        fi
    done
fi

###############################################################################
# Done
###############################################################################
bashio::log.info "Init complete:"
bashio::log.info "  Domain:      ${DOMAIN}"
bashio::log.info "  Upstream:    ${UPSTREAM_HOST}:${UPSTREAM_PORT} (${UPSTREAM_PORT_SOURCE})"
bashio::log.info "  Forwarding:  forwarded_headers ${FORWARDED_HEADERS}, mode $(upstream mode || true)"
bashio::log.info "  mTLS:        ${MTLS_ENABLED}"
bashio::log.info "  ACME DNS:    ${ACME_DNS_PROVIDER}"
bashio::log.info "  Log level:   ${LOG_LEVEL} (caddy=${CADDY_LOG_LEVEL})"
if [[ -n "${SITE_LOG}" ]]; then
    bashio::log.info "  Access log:  on"
else
    bashio::log.info "  Access log:  off (option access_log)"
fi

###############################################################################
# Published host ports (read above). Informational - never fails the start.
###############################################################################
log_host_ports() {
    local http_port="${HTTP_HOST_PORT}" https_port="${HTTPS_HOST_PORT}"
    if [[ "${HOST_PORTS_KNOWN}" != true ]]; then
        bashio::log.info "  Host ports:  unknown (no Supervisor API)"
    else
        bashio::log.info "  Host ports:  80/tcp -> ${http_port:-disabled}, 443/tcp -> ${https_port:-disabled}, 4443/tcp -> ${LAN_HOST_PORT:-disabled}"
    fi
    case "${LAN_STATE}" in
        on)
            bashio::log.info "  LAN port:    https://${DOMAIN}$([[ "${LAN_HOST_PORT}" == 443 ]] || printf ':%s' "${LAN_HOST_PORT}")/ - HTTPS without a client certificate, private source addresses only"
            if (( ${#LAN_REFUSED[@]} > 0 )); then
                bashio::log.info "               (also refused: ${LAN_REFUSED[*]} - Docker's address, it hides the real source)"
            fi
            bashio::log.notice "The local-network port (host port ${LAN_HOST_PORT}) needs no client certificate: never forward it on the router. At home, let ${DOMAIN} resolve to this host's IPv4 address (local DNS)."
            ;;
        off)
            bashio::log.info "  LAN port:    off (4443/tcp has no host port; see the add-on's web interface)"
            ;;
        *)
            bashio::log.info "  LAN port:    off (the host port of 4443/tcp could not be read)"
            ;;
    esac
    [[ "${HOST_PORTS_KNOWN}" == true ]] || return 0
    if [[ -n "${http_port}" && -n "${https_port}" ]]; then
        bashio::log.info "  Router:      forward external TCP 80 -> <this host>:${http_port} and TCP 443 -> <this host>:${https_port}"
    fi
    if [[ -z "${https_port}" ]]; then
        bashio::log.warning "Container port 443/tcp is not published on the host: the proxy is unreachable. Set a host port in the add-on's Network settings."
    fi
    if [[ -z "${http_port}" ]]; then
        if [[ "${ACME_DNS_PROVIDER}" == "none" ]]; then
            bashio::log.warning "Container port 80/tcp is not published on the host: Let's Encrypt's HTTP-01 challenge, the HTTP->HTTPS redirect and the CRL URL cannot work. Publish it or use acme_dns_provider."
        else
            bashio::log.warning "Container port 80/tcp is not published on the host: the HTTP->HTTPS redirect and the CRL URL (http://${DOMAIN}/mTLS-CA.crl) are unreachable."
        fi
    fi
}
log_host_ports || true

###############################################################################
# Facts of this start for the panel's cards and the monitor (public_cert.py,
# upstream.py): the domain, the published host ports (for the port-forwarding
# checklist), the ACME mode, the start time (only certificate events after it
# count) and the upstream with the forwarded_headers option. Not secret.
###############################################################################
jq -n \
    --arg domain "${DOMAIN}" \
    --argjson started_at "${STARTED_AT}" \
    --argjson ports_known "${HOST_PORTS_KNOWN}" \
    --arg http_port "${HTTP_HOST_PORT}" \
    --arg https_port "${HTTPS_HOST_PORT}" \
    --arg dns_provider "${ACME_DNS_PROVIDER}" \
    --arg acme_ca "${ACME_CA_URL}" \
    --arg acme_log "${ACME_LOG}" \
    --arg caddy_storage "${CADDY_DATA}" \
    --arg upstream_host "${UPSTREAM_HOST}" \
    --argjson upstream_port "${UPSTREAM_PORT}" \
    --argjson mtls "${MTLS_BOOL}" \
    --arg forwarded "${FORWARDED_HEADERS}" \
    --arg lan_port "${LAN_HOST_PORT}" \
    --arg lan_state "${LAN_STATE}" \
    --arg lan_refused "${LAN_REFUSED[*]}" \
    --arg config_slug "${CONFIG_SLUG}" \
    '{domain: $domain, started_at: $started_at, host_ports_known: $ports_known,
      http_host_port: ($http_port | tonumber? // null),
      https_host_port: ($https_port | tonumber? // null),
      acme_dns_provider: $dns_provider, acme_ca: $acme_ca,
      acme_log: $acme_log, caddy_storage: $caddy_storage,
      upstream_host: $upstream_host, upstream_port: $upstream_port,
      mtls_enabled: $mtls, forwarded_headers: $forwarded,
      lan_host_port: ($lan_port | tonumber? // null), lan_state: $lan_state,
      lan_refused: ($lan_refused | split(" ") | map(select(. != ""))),
      config_slug: (if $config_slug == "" then null else $config_slug end)}' \
    > "${RUNTIME_FILE}.tmp"
chmod 644 "${RUNTIME_FILE}.tmp"
mv -f "${RUNTIME_FILE}.tmp" "${RUNTIME_FILE}"

###############################################################################
# The connection to the upstream (the panel's "Home Assistant connection"
# card says the same, with the steps): one line while visitor addresses are
# passed on; a short notice while it works without them; the prominent block
# only when every request is answered "400: Bad Request".
###############################################################################
upstream_notice() {
    local card source suggestion error what what_mid title
    card="$(upstream card)"
    source="$(upstream source_address)"
    suggestion="$(upstream suggestion)"
    error="$(upstream error)"
    # How texts name the upstream: at the start of a sentence / inside one;
    # the title of its card in the web interface.
    what="Home Assistant"
    what_mid="Home Assistant"
    title="Home Assistant connection"
    if [[ "${UPSTREAM_HOST}" != "homeassistant" ]]; then
        what="The upstream ${UPSTREAM_HOST}:${UPSTREAM_PORT}"
        what_mid="the upstream ${UPSTREAM_HOST}:${UPSTREAM_PORT}"
        title="Upstream connection"
    fi
    case "${card}" in
        accepted)
            bashio::log.info "${what} accepts this add-on (${source}) as a reverse proxy: visitor addresses are passed on."
            ;;
        strip)
            bashio::log.notice "${what} does not trust this add-on (${source}) as a reverse proxy. The add-on therefore removes the forwarding headers (forwarded_headers: auto, mTLS on): it works, and ${what_mid} sees every visitor as ${source}."
            bashio::log.notice "To pass visitor addresses on, let ${what_mid} trust ${suggestion} as a reverse proxy - the steps are in the add-on's web interface (card \"${title}\")."
            ;;
        never)
            bashio::log.info "forwarded_headers: never - visitor addresses are not passed on; ${what_mid} sees every visitor as ${source:-this add-on}."
            ;;
        unreachable)
            if [[ "$(upstream error_kind)" == http ]]; then
                bashio::log.warning "The upstream ${UPSTREAM_HOST}:${UPSTREAM_PORT} answers with an error (HTTP $(upstream control_status)): $(upstream effect). Forwarding headers meanwhile: mode $(upstream mode) (last known); the add-on checks again every few seconds."
            else
                bashio::log.warning "The upstream ${UPSTREAM_HOST}:${UPSTREAM_PORT} does not answer yet (${error:-no answer}): $(upstream effect) until it does. Forwarding headers until then: mode $(upstream mode) (last known); the add-on checks again every few seconds."
            fi
            ;;
        broken)
            bashio::log.warning "------------------------------------------------------------"
            bashio::log.warning "${what} answers EVERY request through ${DOMAIN}"
            bashio::log.warning "with \"400: Bad Request\": it does not trust this add-on"
            bashio::log.warning "(${source}) as a reverse proxy, and the add-on passes the"
            if [[ "${MTLS_BOOL}" == true ]]; then
                bashio::log.warning "visitor addresses on (forwarded_headers: always)."
            else
                bashio::log.warning "visitor addresses on (mtls_enabled: false - without client"
                bashio::log.warning "certificates no visitor may look like a local device)."
            fi
            bashio::log.warning ""
            if [[ "${UPSTREAM_HOST}" == "homeassistant" ]]; then
                bashio::log.warning "Fix it in Home Assistant: Settings > System > Network >"
                bashio::log.warning "HTTP server > Reverse proxy: turn on 'Trust X-Forwarded-For',"
                bashio::log.warning "add ${suggestion} to 'Trusted proxies', select Save and"
                bashio::log.warning "'Save and restart', then confirm the new settings."
                bashio::log.warning ""
                bashio::log.warning "Home Assistant before 2026.7: add this to configuration.yaml"
                bashio::log.warning "and restart Home Assistant:"
                bashio::log.warning ""
                bashio::log.warning "  http:"
                bashio::log.warning "    use_x_forwarded_for: true"
                bashio::log.warning "    trusted_proxies:"
                bashio::log.warning "      - ${suggestion}"
            else
                bashio::log.warning "Let ${what_mid} trust ${suggestion} as a reverse"
                bashio::log.warning "proxy (X-Forwarded-For)."
            fi
            if [[ "${MTLS_BOOL}" == true ]]; then
                bashio::log.warning ""
                bashio::log.warning "Or set forwarded_headers to auto: ${what_mid} then sees"
                bashio::log.warning "every visitor as ${source}."
            else
                bashio::log.warning ""
                bashio::log.warning "Or turn mTLS on (mtls_enabled: true): with forwarded_headers"
                bashio::log.warning "auto the add-on then hides the visitor addresses."
            fi
            bashio::log.warning ""
            bashio::log.warning "Details: the add-on's web interface (card \"${title}\")."
            bashio::log.warning "------------------------------------------------------------"
            ;;
        *)
            if [[ -n "${error}" ]]; then
                bashio::log.info "${what} did not answer in time (${error}); the add-on checks again in a few seconds."
            else
                bashio::log.info "Connection to the upstream not checked yet; the add-on checks it in a few seconds."
            fi
            ;;
    esac
}
upstream_notice || true
