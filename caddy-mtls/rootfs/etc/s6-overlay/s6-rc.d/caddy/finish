#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: Caddy mTLS Proxy
# Runs when the Caddy process has exited (s6-supervise passes the exit code
# as $1 - 256 if Caddy was killed by a signal - and the signal number as $2).
#
# - Stopping (docker stop / Supervisor's stop or restart): s6 wants the
#   service down. Nothing to do here; s6-rc brings the remaining services
#   down in order. (Until 2.0.0 this script always ran `s6-svscanctl -t`:
#   during a normal stop that was a second shutdown that tore down the s6
#   supervision tree - incl. the oneshot runner - while s6-rc was still
#   stopping the services: "unable to stop service init-caddy: command
#   exited 111".)
# - Caddy crashed (non-zero exit or killed by a signal while s6 wanted it
#   up): the add-on stops with Caddy's exit code (signal N -> 128+N), so
#   Supervisor shows the error state and logs "exited with non-zero exit
#   code"; with the Watchdog enabled it restarts the add-on.
# - Caddy exited with 0 by itself (e.g. a SIGTERM sent to it directly): s6
#   starts it again.
# ==============================================================================
declare exit_code="${1:-0}"
declare signal="${2:-0}"
declare wanted_up

wanted_up="$(s6-svstat -o wantedup . 2>/dev/null)" || wanted_up=""
if [[ "${wanted_up}" == "false" ]]; then
    exit 0
fi

declare reason="exit code ${exit_code}"
if [[ "${exit_code}" -eq 256 ]]; then
    # Killed by a signal. Without s6's state (wanted_up unknown) a SIGTERM is
    # taken as a stop, like the hassio-addons finish scripts do.
    if [[ -z "${wanted_up}" && "${signal}" -eq 15 ]]; then
        exit 0
    fi
    exit_code=$((128 + signal))
    reason="killed by signal ${signal}"
fi

if [[ "${exit_code}" -eq 0 ]]; then
    bashio::log.info "Caddy exited with exit code 0; s6 starts it again."
    exit 0
fi

bashio::log.error "Caddy stopped unexpectedly (${reason}); stopping the add-on with exit code ${exit_code}."
echo "${exit_code}" > /run/s6-linux-init-container-results/exitcode
/run/s6/basedir/bin/halt
# 125: s6-supervise does not restart the service (the add-on is stopping).
exit 125
