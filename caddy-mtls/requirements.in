# Python dependencies of the cert-mgr panel (FastAPI + uvicorn). The
# cert-monitor service (monitor.py, standard library only) runs with the same
# interpreter.
#
# requirements.txt is generated from this file with hashes and installed in
# the image with `pip install --require-hashes --only-binary=:all:` into a
# virtualenv (/usr/lib/cert-mgr/.venv). Regenerate it - with the Python
# version of the image (Alpine 3.24, CPython 3.14) - after changing a pin
# (the base image sets PIP_EXTRA_INDEX_URL to Home Assistant's wheel index;
# it is unset so that only PyPI is consulted, as in the image build):
#
#   docker run --rm -v "$PWD/caddy-mtls:/w" -w /w --entrypoint sh \
#       ghcr.io/hassio-addons/base:21.0.10 -c 'unset PIP_EXTRA_INDEX_URL &&
#       apk add --no-cache python3 >/dev/null &&
#       python3 -m venv /tmp/v && /tmp/v/bin/pip -q install pip-tools==7.6.2 &&
#       /tmp/v/bin/pip-compile -q --generate-hashes --allow-unsafe --strip-extras
#       --no-emit-index-url -o requirements.txt requirements.in'
#
# Minimum versions (security):
#   starlette >= 1.3.1        GHSA-86qp-5c8j-p5mr (Host header -> request.url.path),
#                             GHSA-7f5h-v6xp-fcq8 (Range header DoS), GHSA-wqp7-x3pw-xc5r,
#                             GHSA-x746-7m8f-x49c, GHSA-82w8-qh3p-5jfq
#   python-multipart >= 0.0.31  GHSA-wp53-j4wj-2cfg, GHSA-mj87-hwqh-73pj, GHSA-pp6c-gr5w-3c5g,
#                             GHSA-5rvq-cxj2-64vf and lows
# Alpine 3.24's py3-starlette is 1.1.0 (below the minimum) - which is why the
# panel does not use Alpine's py3-* packages.
#
# starlette is pinned directly: app.py imports it (BaseHTTPMiddleware) and the
# pin enforces the security minimum independently of FastAPI's lower bound.
fastapi==0.162.0
starlette==1.10.0
uvicorn==0.54.0
jinja2==3.1.6
python-multipart==0.0.32
