#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: FRP Tunnel
# Long-running frp-mgr pairing panel (Starlette) served on the ingress port (8099).
#
# The panel (and config.py) read the add-on options straight from
# /data/options.json instead of bashio::config: bashio::config queries the
# Supervisor API, which does not exist when the image runs outside Supervisor
# (E2E tests) and would silently return empty values there.
#
# uvicorn runs from the panel's virtualenv (pinned, hash-checked
# dependencies). --no-proxy-headers: the client address the ingress guard
# checks is always the TCP peer, never a forwarded header.
# ==============================================================================
readonly OPTIONS_FILE="/data/options.json"
readonly APP_DIR="/usr/lib/frp-mgr"
readonly UVICORN="${APP_DIR}/.venv/bin/uvicorn"

LOG_LEVEL="info"
if [[ -r "${OPTIONS_FILE}" ]]; then
    LOG_LEVEL="$(jq -r '.log_level // "info"' "${OPTIONS_FILE}" 2>/dev/null || echo info)"
else
    bashio::log.warning "${OPTIONS_FILE} not found - using built-in defaults."
fi

case "${LOG_LEVEL}" in
    trace|debug)  UVICORN_LOG_LEVEL="debug";   FRP_MGR_LOG_LEVEL="DEBUG" ;;
    warning|warn) UVICORN_LOG_LEVEL="warning"; FRP_MGR_LOG_LEVEL="WARNING" ;;
    error|fatal)  UVICORN_LOG_LEVEL="error";   FRP_MGR_LOG_LEVEL="ERROR" ;;
    *)            UVICORN_LOG_LEVEL="info";    FRP_MGR_LOG_LEVEL="INFO" ;;
esac
export FRP_MGR_LOG_LEVEL

bashio::log.info "Starting frp-mgr pairing panel on port 8099..."

cd "${APP_DIR}" || bashio::exit.nok "frp-mgr application directory missing"
exec "${UVICORN}" app:app \
    --app-dir "${APP_DIR}" \
    --host 0.0.0.0 \
    --port 8099 \
    --no-server-header \
    --no-proxy-headers \
    --log-level "${UVICORN_LOG_LEVEL}"
