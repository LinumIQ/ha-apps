#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: FRP Tunnel
# Wait-loop: frpc is started only after the pairing panel writes
# /data/frpc.toml. While there is no toml, log and sleep.
# ==============================================================================
set -e

readonly CONFIG_FILE="/data/frpc.toml"

bashio::log.info "frpc service waiting for device pairing..."

while true; do
    if [ -f "${CONFIG_FILE}" ] && [ -s "${CONFIG_FILE}" ]; then
        bashio::log.info "frpc config found. Starting frpc..."
        exec /usr/bin/frpc -c "${CONFIG_FILE}"
    fi
    bashio::log.info "No pairing yet — waiting for /data/frpc.toml..."
    sleep 5
done
