#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: FRP Tunnel
# Render /data/frpc.toml from add-on options, then exec frpc.
# ==============================================================================
set -e

readonly CONFIG_FILE="/data/frpc.toml"

SERVER_ADDR="$(bashio::config 'server_addr')"
SERVER_PORT="$(bashio::config 'server_port')"
TOKEN="$(bashio::config 'token')"
SUBDOMAIN="$(bashio::config 'subdomain')"
LOCAL_HOST="$(bashio::config 'local_host')"
LOCAL_PORT="$(bashio::config 'local_port')"
LOG_LEVEL="$(bashio::config 'log_level' 'info')"

###############################################################################
# Validation
###############################################################################
if bashio::var.is_empty "${SERVER_ADDR}"; then
    bashio::exit.nok "Option 'server_addr' is required."
fi

if bashio::var.is_empty "${TOKEN}"; then
    bashio::exit.nok "Option 'token' is required (obtain from the LinumIQ dashboard)."
fi

if bashio::var.is_empty "${SUBDOMAIN}"; then
    bashio::exit.nok "Option 'subdomain' is required."
fi

# Belt-and-braces: the schema already enforces this regex via match(...),
# but reject again at runtime so a bad value can never reach frpc / frps.
if ! [[ "${SUBDOMAIN}" =~ ^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$ ]]; then
    bashio::exit.nok \
        "Invalid subdomain '${SUBDOMAIN}': must be 3-32 chars, lowercase a-z, 0-9 and '-', not starting/ending with '-'."
fi

case "${LOG_LEVEL}" in
    trace|debug|info|warn|error) ;;
    *) bashio::exit.nok "Unknown log_level '${LOG_LEVEL}'." ;;
esac

###############################################################################
# Render /data/frpc.toml
###############################################################################
bashio::log.info "Rendering frpc config for ${SUBDOMAIN}.${SERVER_ADDR} -> ${LOCAL_HOST}:${LOCAL_PORT}..."

cat > "${CONFIG_FILE}" <<EOF
# Auto-generated by the frp-tunnel add-on. Do not edit by hand;
# changes are overwritten on every restart.
serverAddr = "${SERVER_ADDR}"
serverPort = ${SERVER_PORT}
loginFailExit = false

# The frps auth HTTP plugin reads the per-user token from metadatas.token.
# Do NOT use [auth] method = "token" — that puts the token in a top-level
# field that the plugin does not see.
[metadatas]
token = "${TOKEN}"

[log]
to = "console"
level = "${LOG_LEVEL}"

[[proxies]]
name = "${SUBDOMAIN}"
type = "http"
customDomains = ["${SUBDOMAIN}.${SERVER_ADDR}"]
localIP = "${LOCAL_HOST}"
localPort = ${LOCAL_PORT}
EOF

chmod 600 "${CONFIG_FILE}"

bashio::log.info "Starting frpc..."
exec /usr/bin/frpc -c "${CONFIG_FILE}"
