#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: FRP Tunnel
# Runs frpc once the add-on is paired.
#
# On every (re)start of this service /data/frpc.toml is re-rendered from the
# persisted pairing state (/data/frp-state.json) and the add-on options by
# /usr/lib/frp-mgr/config.py, so changed server-provided values (after
# "Refresh tunnel config" or re-pairing) or changed option overrides are
# always picked up. The pairing panel restarts this service (s6-svc -r)
# whenever the state changes; until then it waits.
#
# frpc is started ONLY when the renderer exits 0, i.e. it has just read a
# valid pairing from the state file (under the state lock it shares with
# the panel). A frpc.toml on its own is never trusted:
#   exit 3 (not paired: state file missing, corrupt or incomplete) - the
#          renderer has deleted any leftover frpc.toml (old token); we delete
#          it too and keep waiting. Without a state file the renderer is not
#          even started (cheap wait loop); the panel restarts this service
#          after every pairing, so nothing is missed.
#   exit 4 (the server requires a verified frps connection, but no valid CA
#          is known) - fail closed: frpc is not started (never unverified);
#          retried every 10 seconds, "Refresh tunnel config" fixes it.
#   other  (render error, lock timeout) - frpc is not started from the
#          previous file; retried every 10 seconds.
#
# frpc itself runs as the unprivileged system user `frpc` (s6-setuidgid). It
# can read frpc.toml and the pinned frps CA (root:frpc 0640, written by the
# renderer) but not the state file with the device token (root 0600).
#
# frpc gets a SCRUBBED environment (env -i: PATH, HOME and TZ only). This
# script runs under with-contenv, i.e. with the add-on's full environment
# incl. SUPERVISOR_TOKEN - and frpc renders its configuration file as a Go
# template with the process environment available as {{ .Envs.NAME }}, so a
# template in a config value would otherwise send that token to frps.
#
# frpc's console output goes through the log watcher (frpclog.py, run as a
# coprocess): every line reaches the add-on log unchanged, and login results are recorded in
# /run/frp-mgr/frpc-status.json for the panel (TLS "verified" only after a
# successful login with the pinned CA; automatic refresh after repeated
# login failures).
# ==============================================================================
readonly CONFIG_FILE="/data/frpc.toml"
readonly STATE_FILE="/data/frp-state.json"
readonly RENDERER="/usr/lib/frp-mgr/config.py"
readonly WATCHER="/usr/lib/frp-mgr/frpclog.py"
readonly PYTHON="/usr/lib/frp-mgr/.venv/bin/python3"
readonly OPTIONS_FILE="/data/options.json"
readonly FRPC_USER="frpc"

# Same log-level mapping as the panel (affects the renderer's own messages;
# frpc's level is written into frpc.toml).
FRP_MGR_LOG_LEVEL="INFO"
if [[ -r "${OPTIONS_FILE}" ]]; then
    case "$(jq -r '.log_level // "info"' "${OPTIONS_FILE}" 2>/dev/null || true)" in
        trace|debug)  FRP_MGR_LOG_LEVEL="DEBUG" ;;
        warning|warn) FRP_MGR_LOG_LEVEL="WARNING" ;;
        error|fatal)  FRP_MGR_LOG_LEVEL="ERROR" ;;
    esac
fi
export FRP_MGR_LOG_LEVEL

waiting_logged=false
last_rc=""
while true; do
    rc=0
    if [[ -s "${STATE_FILE}" ]]; then
        "${PYTHON}" "${RENDERER}" render || rc=$?
    else
        rc=3
    fi
    case "${rc}" in
        0)
            # Rendered (or already up to date) from a valid pairing.
            if [[ -s "${CONFIG_FILE}" ]]; then
                bashio::log.info "Starting frpc (as user ${FRPC_USER}, scrubbed environment)..."
                frpc_env=(PATH=/usr/bin:/bin HOME=/data)
                [[ -n "${TZ:-}" ]] && frpc_env+=("TZ=${TZ}")
                # stdout/stderr -> the log watcher, a coprocess writing to the
                # original stdout (fd duplication only: a process substitution
                # would open /dev/fd/N, which the AppArmor profile denies).
                exec 3>&1
                coproc WATCH { exec "${PYTHON}" "${WATCHER}" >&3 3>&-; }
                exec >&"${WATCH[1]}" 2>&1 3>&-
                watch_out="${WATCH[0]}"
                exec {watch_out}<&-
                exec /usr/bin/env -i "${frpc_env[@]}" \
                    /command/s6-setuidgid "${FRPC_USER}" /usr/bin/frpc -c "${CONFIG_FILE}"
            fi
            bashio::log.error "Renderer succeeded but ${CONFIG_FILE} is missing."
            ;;
        3)
            # Not paired (yet, or any more): never run a leftover config.
            rm -f "${CONFIG_FILE}"
            if [[ "${waiting_logged}" == false ]]; then
                bashio::log.info "Not paired yet - open the FRP Tunnel panel to pair this device."
                waiting_logged=true
            fi
            ;;
        4)
            # No valid frps CA although the server requires verification:
            # fail closed (the renderer has removed frpc.toml).
            rm -f "${CONFIG_FILE}"
            if [[ "${last_rc}" != "${rc}" ]]; then
                bashio::log.error "frpc is NOT started: no valid certificate authority for the tunnel server (see the panel). Retrying every 10 s."
            fi
            ;;
        *)
            if [[ "${last_rc}" != "${rc}" ]]; then
                bashio::log.error "Rendering frpc.toml failed (exit ${rc}); frpc is not started. Retrying every 10 s."
            fi
            ;;
    esac
    last_rc="${rc}"
    sleep 10
done
